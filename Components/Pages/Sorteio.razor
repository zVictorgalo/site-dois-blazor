@page "/sorteio"
@rendermode InteractiveServer

<PageTitle>Sorteador de Números</PageTitle>
<h1>Sorteador de Números</h1>
<p>Sorteie um número entre 1 e 100.</p>
<button type="button" @onclick="SorteiaNumero">Gerar Número Aleatório</button>
<div aria-live="polite">
    @if (numeroSorteado.HasValue)
    {
        <h2>@numeroSorteado.Value</h2>
    }
</div>

@code {
    private int? numeroSorteado;
    private readonly Random random = new();

    private void SorteiaNumero()
    {
        // O limite superior é exclusivo: 101 permite sortear até 100.
        numeroSorteado = random.Next(1, 101);
    }
}
